#: dtMediaWiki.lua:53
msgid "Commons: Description languages"
msgstr "Commons: Beschreibungssprachen"

#: dtMediaWiki.lua:54
msgid "Language codes shown as description fields in the Commons metadata panel, "
"separated by commas or semicolons (eg: en,de). Descriptions in other "
"languages can be added with the 'Other descriptions' field."
msgstr "Sprachcodes, für die im Commons-Metadateneditor ein Beschreibungsfeld "
"angezeigt wird, durch Kommas oder Semikolons getrennt (z. B. en,de). "
"Beschreibungen in anderen Sprachen können mit dem Feld 'Weitere "
"Beschreibungen' hinzugefügt werden."

#: dtMediaWiki.lua:69
msgid "Commons: Categorize camera?"
msgstr "Commons: Nach Kamera kategorisieren?"

#: dtMediaWiki.lua:70
msgid "A category will be added with the camera information (eg: [[Category:Taken "
"with Fujifilm X-E2 and XF18-55mmF2.8-4 R LM OIS]])"
msgstr "Eine Kategorie mit den Kamerainformationen wird hinzugefügt (z. B. "
"[[Category:Taken with Fujifilm X-E2 and XF18-55mmF2.8-4 R LM OIS]])."

#: dtMediaWiki.lua:79
msgid "Commons: Category tag format"
msgstr "Commons: Format der Kategori-Tags"

#: dtMediaWiki.lua:80
msgid "Tag format used when saving categories from the Commons metadata editor. "
"Both formats are read back and exported as [[Category:...]]."
msgstr "Tag-Format, das beim Speichern von Kategorien aus dem "
"Commons-Metadateneditor verwendet wird. Beide Formate werden gleich gelesen "
"und als [[Category:...]] exportiert."

#: dtMediaWiki.lua:92
msgid "Commons: Templates to be placed in {{Information |description= ...}}"
msgstr "Commons: Vorlagen für {{Information |description= ...}}"

#: dtMediaWiki.lua:93
msgid "These templates are placed in the {{Information |description= ...}} field. "
"(comma-separated)"
msgstr "Diese Vorlagen werden in das Feld {{Information |description= ...}} "
"eingefügt (durch Kommas getrennt)."

#: dtMediaWiki.lua:101
msgid "Commons: Overwrite existing images?"
msgstr "Commons: Vorhandene Dateien überschreiben?"

#: dtMediaWiki.lua:102
msgid "Existing images will be overwritten  without confirmation, otherwise the "
"upload will fail."
msgstr "Vorhandene Dateien werden ohne Rückfrage überschrieben; andernfalls schlägt "
"der Upload fehl."

#: dtMediaWiki.lua:110
msgid "Commons: Preferred author pattern"
msgstr "Commons: Bevorzugtes Muster für den Urheber"

#: dtMediaWiki.lua:111
msgid "Determines the author value; variables are $USERNAME, $CREATOR"
msgstr "Legt den Wert für den Urheber fest; Variablen sind $USERNAME und $CREATOR."

#: dtMediaWiki.lua:119
msgid "Commons: Preferred filename pattern"
msgstr "Commons: Bevorzugtes Dateinamensmuster"

#: dtMediaWiki.lua:120
msgid "Determines the filename value; variables are $TITLE, $DESCRIPTION, "
"$FILE_NAME"
msgstr "Legt den Dateinamen fest; Variablen sind $TITLE, $DESCRIPTION und "
"$FILE_NAME."

#: dtMediaWiki.lua:129
msgid "Commons: Allow empty 'Information|description' on page?"
msgstr "Commons: Leeres Feld „Information|description“ auf der Seite erlauben?"

#: dtMediaWiki.lua:130
msgid "If unchecked (default), images where both title and description metadata are "
"empty will not be uploaded, as this results in an empty "
"'{{Information|description=...}}' field on Wikimedia Commons. If checked, "
"such uploads are allowed (unless the filename pattern specifically requires "
"title or description)."
msgstr "Wenn diese Option deaktiviert ist (Standard), werden Bilder ohne Titel und "
"Beschreibung nicht hochgeladen, da dadurch auf Wikimedia Commons ein leeres "
"Feld „{{Information|description=...}}“ entsteht. Ist die Option aktiviert, "
"sind solche Uploads erlaubt (sofern das Dateinamensmuster nicht ausdrücklich "
"einen Titel oder eine Beschreibung erfordert)."

#: dtMediaWiki.lua:144
msgid "Commons: Default license"
msgstr "Commons: Standardlizenz"

#: dtMediaWiki.lua:145
msgid "Default license for images uploaded to Wikimedia Commons (eg: CC-BY-SA-4.0, "
"CC-BY-4.0, PD, ...)"
msgstr "Standardlizenz für zu Wikimedia Commons hochgeladene Bilder (z. B. "
"CC-BY-SA-4.0, CC-BY-4.0, PD, ...)."

#: dtMediaWiki.lua:153
msgid "Wikimedia password"
msgstr "Wikimedia-Passwort"

#: dtMediaWiki.lua:154
msgid "Wikimedia Commons password (to be stored in plain-text!)"
msgstr "Wikimedia-Commons-Passwort (wird im Klartext gespeichert!)."

#: dtMediaWiki.lua:162
msgid "Wikimedia username"
msgstr "Wikimedia-Benutzername"

#: dtMediaWiki.lua:163
msgid "Wikimedia Commons username"
msgstr "Wikimedia-Commons-Benutzername"

#: dtMediaWiki.lua:173
msgid "Determines the `File:` page name on Wikimedia Commons."
msgstr "Legt den Namen der `File:`-Seite auf Wikimedia Commons fest."

#: dtMediaWiki.lua:175
msgid "Placeholder syntax:"
msgstr "Platzhalter-Syntax:"

#: dtMediaWiki.lua:176
msgid "  <dateYYYYMMDD> - capture date as YYYYMMDD"
msgstr "  <dateYYYYMMDD> – Aufnahmedatum als YYYYMMDD"

#: dtMediaWiki.lua:177
msgid "  <title> - title from image metadata"
msgstr "  <title> – Titel aus den Bildmetadaten"

#: dtMediaWiki.lua:178
msgid "  <fileName> - original filename using the export extension"
msgstr "  <fileName> – ursprünglicher Dateiname mit der Export-Dateiendung"

#: dtMediaWiki.lua:179
msgid "  and other placeholders available in the selector below"
msgstr "  sowie weitere Platzhalter aus der Auswahl unten"

#: dtMediaWiki.lua:181
msgid "Legacy variables are still supported:"
msgstr "Ältere Variablen werden weiterhin unterstützt:"

#: dtMediaWiki.lua:182
msgid "  $FILE_NAME"
msgstr "  $FILE_NAME"

#: dtMediaWiki.lua:183
msgid "  $TITLE"
msgstr "  $TITLE"

#: dtMediaWiki.lua:184
msgid "  $DESCRIPTION"
msgstr "  $DESCRIPTION"

#: dtMediaWiki.lua:217
msgid "Insert placeholder"
msgstr "Platzhalter einfügen"

#: dtMediaWiki.lua:218
msgid "Append a placeholder to the filename pattern above. Select an entry to "
"insert it; the selector then resets to blank."
msgstr "Fügt einen Platzhalter zum Dateinamensmuster oben hinzu. Eintrag auswählen "
"zum Einfügen; die Auswahl wird danach wieder geleert."

#: dtMediaWiki.lua:272
msgid "Description language code. Additional descriptions may be added with tag "
"{{Description|language_code|description_text}} or any of the templates "
"listed in the desc_template setting."
msgstr "Sprachcode der Beschreibung. Weitere Beschreibungen können mit dem Tag "
"{{Description|language_code|description_text}} oder mit einer der in der "
"Einstellung desc_template aufgeführten Vorlagen hinzugefügt werden."

#: dtMediaWiki.lua:339
msgid "Filename pattern resulted in an empty name, falling back to input image "
"basename."
msgstr "Das Dateinamensmuster ergab einen leeren Namen; stattdessen wird der "
"Basisname des Eingabebildes verwendet."

#: dtMediaWiki.lua:447
msgid "Commons categories added to every image in this export. Enter one category "
"per line, without [[Category:...]]."
msgstr "Commons-Kategorien, die jedem Bild dieses Exports hinzugefügt werden. Eine "
"Kategorie pro Zeile eingeben, ohne [[Category:...]]."

#: dtMediaWiki.lua:462
msgid "Additional Wikitext added to every Commons file page in this export, for "
"example {{Supported by Wikimedia Österreich}}."
msgstr "Zusätzlicher Wikitext, der jeder Commons-Dateiseite dieses Exports "
"hinzugefügt wird, zum Beispiel {{Supported by Wikimedia Österreich}}."

