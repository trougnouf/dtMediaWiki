#: dtMediaWiki.lua:53
msgid "Commons: Description languages"
msgstr "Commons: idiomas de descripción"

#: dtMediaWiki.lua:54
msgid "Language codes shown as description fields in the Commons metadata panel, "
"separated by commas or semicolons (eg: en,de). Descriptions in other "
"languages can be added with the 'Other descriptions' field."
msgstr "Códigos de idioma que se muestran como campos de descripción en el panel de "
"metadatos de Commons, separados por comas o puntos y comas (p. ej.: en,es). "
"Las descripciones en otros idiomas pueden añadirse con el campo «Otras "
"descripciones»."

#: dtMediaWiki.lua:69
msgid "Commons: Categorize camera?"
msgstr "Commons: ¿categorizar por cámara?"

#: dtMediaWiki.lua:70
msgid "A category will be added with the camera information (eg: [[Category:Taken "
"with Fujifilm X-E2 and XF18-55mmF2.8-4 R LM OIS]])"
msgstr "Se añadirá una categoría con la información de la cámara (p. ej.: "
"[[Category:Taken with Fujifilm X-E2 and XF18-55mmF2.8-4 R LM OIS]])"

#: dtMediaWiki.lua:79
msgid "Commons: Category tag format"
msgstr "Commons: formato de las etiquetas de categoría"

#: dtMediaWiki.lua:80
msgid "Tag format used when saving categories from the Commons metadata editor. "
"Both formats are read back and exported as [[Category:...]]."
msgstr "Formato de etiqueta usado al guardar categorías desde el editor de metadatos "
"de Commons. Ambos formatos se vuelven a leer y se exportan como "
"[[Category:...]]."

#: dtMediaWiki.lua:92
msgid "Commons: Templates to be placed in {{Information |description= ...}}"
msgstr "Commons: plantillas que se colocan en {{Information |description= ...}}"

#: dtMediaWiki.lua:93
msgid "These templates are placed in the {{Information |description= ...}} field. "
"(comma-separated)"
msgstr "Estas plantillas se colocan en el campo {{Information |description= ...}} "
"(separadas por comas)."

#: dtMediaWiki.lua:101
msgid "Commons: Overwrite existing images?"
msgstr "Commons: ¿sobrescribir las imágenes existentes?"

#: dtMediaWiki.lua:102
msgid "Existing images will be overwritten  without confirmation, otherwise the "
"upload will fail."
msgstr "Las imágenes existentes se sobrescribirán sin confirmación; de lo contrario, "
"la subida fallará."

#: dtMediaWiki.lua:110
msgid "Commons: Preferred author pattern"
msgstr "Commons: patrón de autor preferido"

#: dtMediaWiki.lua:111
msgid "Determines the author value; variables are $USERNAME, $CREATOR"
msgstr "Determina el valor del autor; las variables son $USERNAME y $CREATOR"

#: dtMediaWiki.lua:119
msgid "Commons: Preferred filename pattern"
msgstr "Commons: patrón de nombre de archivo preferido"

#: dtMediaWiki.lua:120
msgid "Determines the filename value; variables are $TITLE, $DESCRIPTION, "
"$FILE_NAME"
msgstr "Determina el nombre de archivo; las variables son $TITLE, $DESCRIPTION y "
"$FILE_NAME"

#: dtMediaWiki.lua:129
msgid "Commons: Allow empty 'Information|description' on page?"
msgstr "Commons: ¿permitir un campo «Information|description» vacío en la página?"

#: dtMediaWiki.lua:130
msgid "If unchecked (default), images where both title and description metadata are "
"empty will not be uploaded, as this results in an empty "
"'{{Information|description=...}}' field on Wikimedia Commons. If checked, "
"such uploads are allowed (unless the filename pattern specifically requires "
"title or description)."
msgstr "Si no está marcada (predeterminado), no se subirán las imágenes cuyo título "
"y descripción estén vacíos, ya que esto produce un campo "
"«{{Information|description=...}}» vacío en Wikimedia Commons. Si está "
"marcada, se permiten estas subidas (salvo que el patrón de nombre de archivo "
"requiera expresamente un título o una descripción)."

#: dtMediaWiki.lua:144
msgid "Commons: Default license"
msgstr "Commons: licencia predeterminada"

#: dtMediaWiki.lua:145
msgid "Default license for images uploaded to Wikimedia Commons (eg: CC-BY-SA-4.0, "
"CC-BY-4.0, PD, ...)"
msgstr "Licencia predeterminada para las imágenes subidas a Wikimedia Commons (p. "
"ej.: CC-BY-SA-4.0, CC-BY-4.0, PD, ...)"

#: dtMediaWiki.lua:153
msgid "Wikimedia password"
msgstr "Contraseña de Wikimedia"

#: dtMediaWiki.lua:154
msgid "Wikimedia Commons password (to be stored in plain-text!)"
msgstr "Contraseña de Wikimedia Commons (¡se guarda en texto plano!)"

#: dtMediaWiki.lua:162
msgid "Wikimedia username"
msgstr "Nombre de usuario de Wikimedia"

#: dtMediaWiki.lua:163
msgid "Wikimedia Commons username"
msgstr "Nombre de usuario de Wikimedia Commons"

#: dtMediaWiki.lua:173
msgid "Determines the `File:` page name on Wikimedia Commons."
msgstr "Determina el nombre de la página `File:` en Wikimedia Commons."

#: dtMediaWiki.lua:175
msgid "Placeholder syntax:"
msgstr "Sintaxis de los marcadores:"

#: dtMediaWiki.lua:176
msgid "  <dateYYYYMMDD> - capture date as YYYYMMDD"
msgstr "  <dateYYYYMMDD> – fecha de captura como YYYYMMDD"

#: dtMediaWiki.lua:177
msgid "  <title> - title from image metadata"
msgstr "  <title> – título de los metadatos de la imagen"

#: dtMediaWiki.lua:178
msgid "  <fileName> - original filename using the export extension"
msgstr "  <fileName> – nombre de archivo original con la extensión de exportación"

#: dtMediaWiki.lua:179
msgid "  and other placeholders available in the selector below"
msgstr "  y otros marcadores disponibles en el selector de abajo"

#: dtMediaWiki.lua:181
msgid "Legacy variables are still supported:"
msgstr "Las variables antiguas siguen siendo compatibles:"

#: dtMediaWiki.lua:182
msgid "  $FILE_NAME"
msgstr "  $FILE_NAME"

#: dtMediaWiki.lua:183
msgid "  $TITLE"
msgstr "  $TITLE"

#: dtMediaWiki.lua:184
msgid "  $DESCRIPTION"
msgstr "  $DESCRIPTION"

#: dtMediaWiki.lua:217
msgid "Insert placeholder"
msgstr "Insertar marcador"

#: dtMediaWiki.lua:218
msgid "Append a placeholder to the filename pattern above. Select an entry to "
"insert it; the selector then resets to blank."
msgstr "Añade un marcador al patrón de nombre de archivo de arriba. Seleccione una "
"entrada para insertarla; después el selector vuelve a quedar en blanco."

#: dtMediaWiki.lua:272
msgid "Description language code. Additional descriptions may be added with tag "
"{{Description|language_code|description_text}} or any of the templates "
"listed in the desc_template setting."
msgstr "Código de idioma de la descripción. Pueden añadirse más descripciones con la "
"etiqueta {{Description|language_code|description_text}} o con cualquiera de "
"las plantillas indicadas en el ajuste desc_template."

#: dtMediaWiki.lua:339
msgid "Filename pattern resulted in an empty name, falling back to input image "
"basename."
msgstr "El patrón de nombre de archivo produjo un nombre vacío; se usa el nombre "
"base de la imagen de origen."

#: dtMediaWiki.lua:447
msgid "Commons categories added to every image in this export. Enter one category "
"per line, without [[Category:...]]."
msgstr "Categorías de Commons añadidas a cada imagen de esta exportación. Introduzca "
"una categoría por línea, sin [[Category:...]]."

#: dtMediaWiki.lua:462
msgid "Additional Wikitext added to every Commons file page in this export, for "
"example {{Supported by Wikimedia Österreich}}."
msgstr "Wikitexto adicional añadido a cada página de archivo de Commons de esta "
"exportación, por ejemplo {{Supported by Wikimedia Österreich}}."

