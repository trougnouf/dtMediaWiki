#: dtMediaWiki.lua:1224
msgid "is missing a description, which is required by the filename pattern"
msgstr "no tiene descripción, y el patrón de nombre de archivo la requiere"

#: dtMediaWiki.lua:1237
msgid "is missing both title and description, resulting in an empty "
"'Information|description' field on the Commons page (and the 'Allow empty "
